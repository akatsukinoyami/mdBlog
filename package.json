{
  "name": "20250603-mdblog-remake-2.0",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "prebake": "bun build:post:tree && bun lint",
    "bake": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "caprover:archive": "tar czf blog.tar.gz build captain-definition nginx.conf",
    "caprover:build": "bun build && bun caprover:delete && bun caprover:archive",
    "caprover:delete": "rm -f blog.tar.gz",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint --max-warnings 0 .",
    "build:post:tree": "bun scripts/01_buildTree.ts static/files > static/posts.yaml",
    "json:to:yaml": "find static/files/ -type f -name '*.json' -exec sh -c 'js-yaml \"$1\" > \"${1%.json}.yaml\"' _ {} \\;"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.5",
    "@eslint/js": "^9.18.0",
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.15.30",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.2.6"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.2.5",
    "@mdi/js": "^7.4.47",
    "@sveltejs/adapter-static": "^3.0.8",
    "@types/showdown": "^2.0.6",
    "showdown": "^2.1.0",
    "svelte-loading-spinners": "^0.3.6",
    "svelte-sonner": "^1.0.4",
    "yaml": "^2.8.0"
  }
}
