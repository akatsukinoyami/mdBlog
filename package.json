{
  "name": "mdblog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "yarn build && yarn preview",
    "build": "vite build",
    "preview": "vite preview",
    "postbuild": "yarn posthandler && yarn compressor",
    "caprover:archiveInner": "tar czf blog.tar.gz dist captain-definition Dockerfile nginx.conf",
    "caprover:archive": "yarn caprover:delete && yarn caprover:archiveInner",
    "caprover:build": "yarn fix:permissions && yarn build && yarn caprover:archive",
    "caprover:delete": "rm -f blog.tar.gz",
    "compressor": "node ./scripts/compressor.js",
    "fix:sharp": "yarn add -D sharp --ignore-engines",
    "fix:permissions": "chown -R $USER blog && chmod -R 744 blog",
    "posthandler": "node ./scripts/postHandler.js",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.0.1",
    "@tsconfig/svelte": "^5.0.2",
    "@types/showdown": "^2.0.6",
    "autoprefixer": "^10.4.19",
    "brotli": "^1.3.3",
    "carbon-components-svelte": "^0.75.1",
    "carbon-icons-svelte": "^11.4.0",
    "glob": "^10.3.10",
    "html-svelte-parser": "^0.0.1",
    "postcss": "^8.4.38",
    "sass": "^1.75.0",
    "sharp": "^0.33.4",
    "showdown": "^2.1.0",
    "svelte": "^4.2.8",
    "svelte-check": "^3.6.2",
    "tailwindcss": "^3.4.3",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  },
  "dependencies": {
    "svelte-navigator": "^3.2.2"
  }
}
