{
  "name": "mdblog",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "bun run build && bun run preview",
    "build": "vite build",
    "preview": "vite preview",
    "postbuild": "bun posthandler && bun compressor",
    "caprover:archiveInner": "tar czf blog.tar.gz dist captain-definition Dockerfile nginx.conf",
    "caprover:archive": "bun caprover:delete && bun caprover:archiveInner",
    "caprover:build": "bun fix:permissions && bun build && bun caprover:archive",
    "caprover:delete": "rm -f blog.tar.gz",
    "compressor": "node ./scripts/compressor.js",
    "fix:sharp": "bun add -D sharp --ignore-engines",
    "fix:permissions": "chown -R $USER blog && chmod -R 744 blog",
    "posthandler": "node ./scripts/postHandler.js",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.0.1",
    "@tsconfig/svelte": "^5.0.2",
    "@types/pdfkit": "^0.13.4",
    "@types/showdown": "^2.0.6",
    "brotli": "^1.3.3",
    "carbon-components-svelte": "^0.75.1",
    "carbon-icons-svelte": "^11.4.0",
    "glob": "^10.3.10",
    "html-svelte-parser": "^0.0.1",
    "sass": "^1.75.0",
    "sharp": "^0.33.4",
    "showdown": "^2.1.0",
    "svelte": "^4.2.8",
    "svelte-check": "^3.6.2",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2",
    "vite": "^5.2.11"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "pdfkit": "^0.15.0",
    "svelte-navigator": "^3.2.2",
    "yaml": "^2.4.2"
  }
}
