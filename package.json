{
  "name": "20250603-mdblog-remake-2.0",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "bun posts && vite dev",
    "prebake": "bun lint && bun check:18n && bun posts && bun compress:images",
    "bake": "vite build",
    "postbake": "bun compress:text",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint --max-warnings 0 .",
    "posts": "bun scripts/01_buildTree.ts static/files > static/posts.yaml",
    "compress:text": "bun --bun scripts/02_compressText.ts",
    "compress:images": "bun --bun scripts/03_compressImages.ts",
    "check:18n": "bun --bun scripts/04_checkLocales.ts",
    "json:to:yaml": "find static/files/ -type f -name '*.json' -exec sh -c 'js-yaml \"$1\" > \"${1%.json}.yaml\"' _ {} \\;"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.5",
    "@eslint/js": "^9.18.0",
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "^1.2.15",
    "@types/node": "^22.15.30",
    "@types/showdown": "^2.0.6",
    "bun-types": "^1.2.15",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.2.6"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.2.5",
    "@mdi/js": "^7.4.47",
    "cookie": "^1.0.2",
    "devalue": "^5.1.1",
    "highlight.js": "^11.11.1",
    "set-cookie-parser": "^2.7.1",
    "sharp": "^0.34.2",
    "showdown": "^2.1.0",
    "svelte-adapter-bun": "^0.5.2",
    "svelte-sonner": "^1.0.4",
    "yaml": "^2.8.0"
  }
}
